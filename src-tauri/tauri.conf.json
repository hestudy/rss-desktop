{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rss-desktop",
  "version": "0.0.1",
  "identifier": "com.hestudy.rss-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RSS Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwQzE5NUE3OEY2NEM2MjMKUldRanhtU1BwNVhCa0VkMkU1TWM2b1BXZjhxdEVxMFo5SS9aMzk0RTZnNE93U0YwSkVMVXhOT1gK",
      "endpoints": [
        "https://github.com/hestudy/rss-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
